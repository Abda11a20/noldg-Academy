{
  "name": "noldg-academy-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @noldg/portal dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 --ignore-pattern tools/lint-fixtures/**",
    "lint:rules": "node tools/lint-fixtures/verify.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node apps/portal/scripts/run-e2e.mjs",
    "check:bundle-size": "node apps/portal/scripts/check-bundle-size.mjs",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:full": "pnpm audit --audit-level high",
    "check:no-dev-routes": "node tools/check-no-dev-routes.mjs",
    "test:headers": "node --test apps/portal/scripts/generate-headers.test.mjs",
    "precommit": "lint-staged",
    "knip": "knip",
    "dependency-cruiser": "depcruise --config .dependency-cruiser.cjs apps packages",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@boundaries/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": "prettier --write"
  },
  "msw": {
    "workerDirectory": [
      "apps\\portal\\public"
    ]
  }
}
